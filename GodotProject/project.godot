; Engine configuration file.
; Apptya Kingdom Godot port prototype.

config_version=5

[application]
config/name="Apptya Kingdom"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/description="Mobile-first fantasy kingdom strategy prototype"

[display]
window/size/viewport_width=480
window/size/viewport_height=960
window/size/window_width_override=480
window/size/window_height_override=960
window/handheld/orientation=1
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.055, 0.075, 0.09, 1)
